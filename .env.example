# Copy to .env and adjust. In dev and test, config/config.exs loads .env
# automatically; variables already set in your shell win. In production,
# set these as real environment variables (config/runtime.exs reads them).

## Database (dev / test)
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_dev
DB_TEST_NAME=portfolio_test
# Optional: partitions the test database for parallel CI runs
# MIX_TEST_PARTITION=

## Production (config/runtime.exs)
# ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=ecto://postgres:postgres@localhost/portfolio_prod
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
PHX_HOST=example.com
PORT=4000
# Set to true to start the web server in a release
PHX_SERVER=true
POOL_SIZE=10
# Set to true or 1 to connect to the database over IPv6
ECTO_IPV6=false
# Optional: DNS query for clustering nodes, e.g. with dns_cluster
DNS_CLUSTER_QUERY=
